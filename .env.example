# ==========================================================
# 🤖 AI Conversation Platform v5.0 — Example Environment File
# ==========================================================
# Copy this file to `.env` and customize values as needed.
# Example: cp .env.example .env
# ==========================================================

# -----------------------------
# 🌐 General App Configuration
# -----------------------------
DATA_DIR=data                      # Where conversation logs & DBs are stored
DEFAULT_MAX_TURNS=50               # Default conversation turns
DEFAULT_TIMEOUT_MINUTES=30         # Max timeout per run (minutes)
MAX_CONTEXT_MSGS=10                # Number of messages kept in memory context
MAX_MESSAGE_LENGTH=100000          # Max token length safeguard for messages
ENABLE_LLM_GUARD=true              # Enables LLM prompt-injection protection

# -----------------------------
# 🧠 LLM Model Configuration
# -----------------------------
# Default models for each AI provider (override as needed)
CLAUDE_MODEL=claude-sonnet-4-6
CHATGPT_MODEL=gpt-4o
GEMINI_MODEL=gemini-2.0-flash
GROK_MODEL=grok-3
PERPLEXITY_MODEL=sonar-pro

# -----------------------------
# 🔑 API Keys
# -----------------------------
# At least two providers are required for conversations
# Gemini accepts either GOOGLE_API_KEY or GEMINI_API_KEY (useful for GitHub Codespaces)
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx
GOOGLE_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Optional additional providers
GROK_API_KEY=
PERPLEXITY_API_KEY=

# -----------------------------
# ⚙️ LLM Generation Settings
# -----------------------------
TEMPERATURE=0.7                    # Randomness of model output (0.0–2.0)
MAX_TOKENS=1024                    # Token limit per response
MAX_RESPONSE_WORDS=180             # Soft per-reply word budget (keeps replies focused)
SIMILARITY_THRESHOLD=0.85          # Similarity threshold for message dedup
MAX_CONSECUTIVE_SIMILAR=2          # Max consecutive near-identical turns

# -----------------------------
# 🔄 Retry & Backoff
# -----------------------------
# INITIAL_BACKOFF=2.0
# MAX_BACKOFF=120.0
# BACKOFF_MULTIPLIER=2.0
# JITTER_RANGE=0.2

# -----------------------------
# 🧰 Redis (Optional)
# -----------------------------
# Used for async queues & shared state. Leave empty to disable.
REDIS_URL=redis://redis:6379/0

# -----------------------------
# 📊 Metrics & Observability
# -----------------------------
PROMETHEUS_PORT=8000
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317

# -----------------------------
# 🪵 Logging
# -----------------------------
DEFAULT_LOG_DIR=logs               # Folder for structured logs

# -----------------------------
# 🐳 Docker Integration Notes
# -----------------------------
# docker-compose.yml mounts data & logs into these paths:
# - ./data → /app/data
# - ./logs → /app/logs

